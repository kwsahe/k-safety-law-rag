LLM_PROVIDER=remote_openai
LLM_MODEL=LGAI-EXAONE/EXAONE-4.0-32B
LLM_API_BASE=https://YOUR_COLAB_ENDPOINT/v1
LLM_API_KEY=replace-me

WEB_ADMIN_USERNAME=admin
WEB_ADMIN_PASSWORD=replace-with-a-long-random-password
WEB_ALLOW_REGISTRATION=false
WEB_SECURE_COOKIES=false
WEB_ALLOWED_HOSTS=localhost,127.0.0.1
WEB_MAX_REQUEST_BYTES=1048576
WEB_LOGIN_ATTEMPT_LIMIT=5
WEB_LOGIN_ATTEMPT_WINDOW=300
