LLM_PROVIDER=remote_openai
LLM_MODEL=LGAI-EXAONE/EXAONE-4.0-32B
LLM_API_BASE=https://YOUR_COLAB_ENDPOINT/v1
LLM_API_KEY=replace-me

# Claude API로 전환: 위 LLM_PROVIDER 값을 anthropic 으로 바꾸면 됩니다.
# (위 Colab 설정은 그대로 두어도 되며, remote_openai 로 되돌리면 다시 Colab 모델을 사용합니다.)
ANTHROPIC_API_KEY=replace-me
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max (높을수록 신중하지만 느리고 비쌈)
ANTHROPIC_EFFORT=medium

# 관리자 품질 관리 화면의 "EXAONE/Qwen 연결 확인" 버튼이 확인할 Colab 서버 주소입니다.
# 각 Colab 노트북이 출력한 ngrok 주소 끝에 /v1을 붙여 넣으세요. 답변 모델 선택과는 별개입니다.
EXAONE_API_BASE=
QWEN_API_BASE=

WEB_ADMIN_USERNAME=admin
WEB_ADMIN_PASSWORD=replace-with-a-long-random-password
WEB_ALLOW_REGISTRATION=false
WEB_SECURE_COOKIES=false
WEB_ALLOWED_HOSTS=localhost,127.0.0.1
WEB_MAX_REQUEST_BYTES=1048576
WEB_LOGIN_ATTEMPT_LIMIT=5
WEB_LOGIN_ATTEMPT_WINDOW=300
